# Copie para .env.local e preencha com credenciais de TESTE/DEV.
# NUNCA commite valores reais. Produção vive só nos painéis (Vercel / GitHub Environments).
# Segredos reais: cofre do time (gerenciador de senhas), nunca chat/e-mail.

# --- App ---
NEXT_PUBLIC_APP_NAME=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (use o projeto de TESTES; service role jamais fora do servidor) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_CARDAPIO_BUCKET=
SUPABASE_PRODUTOS_BUCKET=

# --- Mercado Pago (credenciais/usuários de TESTE fora de produção) ---
MERCADO_PAGO_CLIENT_ID=
MERCADO_PAGO_CLIENT_SECRET=
MERCADO_PAGO_REDIRECT_URI=
MERCADO_PAGO_STATE_SECRET=
# Assinatura secreta dos webhooks (app do Mercado Pago > Webhooks > Configurar notificações). Obrigatória em produção.
MERCADO_PAGO_WEBHOOK_SECRET=
PIX_PAYMENT_MAIN_EMAIL=

# --- Stripe (test mode fora de produção) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ASSINATURA_PRICE_ID=

# --- WhatsApp Business / Meta ---
WHATSAPP_BUSINESS_ACCESS_TOKEN=
WHATSAPP_BUSINESS_API_VERSION=
WHATSAPP_BUSINESS_PHONE_NUMBER_ID=
WHATSAPP_META_APP_ID=
WHATSAPP_META_APP_SECRET=
WHATSAPP_META_REDIRECT_URI=
WHATSAPP_META_STATE_SECRET=
WHATSAPP_TEMPLATE_LANGUAGE_CODE=
WHATSAPP_TEMPLATE_STATUS_PEDIDO=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# --- Meta Ads ---
META_ADS_API_VERSION=
META_ADS_APP_ID=
META_ADS_APP_SECRET=
META_ADS_REDIRECT_URI=
META_ADS_STATE_SECRET=

# --- iFood ---
IFOOD_API_BASE_URL=
IFOOD_CLIENT_ID=
IFOOD_CLIENT_SECRET=

# --- Web Push (par VAPID diferente por ambiente) ---
NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=

# --- Google Maps (chaves distintas por ambiente, restritas por domínio) ---
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
